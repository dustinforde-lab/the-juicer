DB_PATH = getattr(config, 'DB_PATH', 'action_grid.db')

@st.cache_resource
def init_syndicate_scheduler():
    try:
        log_fn = thread_safe_log_fn(DB_PATH)
        sched = JobScheduler(log_fn=log_fn)
        if hasattr(learning_loop, 'recalculate_weights'):
            sched.register_job("bayesian_recalibration", learning_loop.recalculate_weights, interval_seconds=86400, run_at_start=False)
        def run_full_pipeline():
            try:
                if hasattr(mike_evaluator_v2, "evaluate_top_300"):
                    mike_evaluator_v2.evaluate_top_300()
                if hasattr(generate_dfs, "generate_lineups_and_slips"):
                    generate_dfs.generate_lineups_and_slips()
            except Exception as e:
                print(f"[PIPELINE ERROR]: {e}")

        sched.register_job("live_scoreboard_sync", scoreboard_engine.sync_espn_data, interval_seconds=30, run_at_start=True)
        sched.register_job("full_pipeline", run_full_pipeline, interval_seconds=3600, run_at_start=True)
        if hasattr(live_medic_poller, "poll_live_injury_trends"):
            sched.register_job("injury_poller", live_medic_poller.poll_live_injury_trends, interval_seconds=1800, run_at_start=True)
        if hasattr(upgrade_meteorologist, "deploy_meteorologist"):
            sched.register_job("weather_feed", upgrade_meteorologist.deploy_meteorologist, interval_seconds=3600, run_at_start=True)
        sched.start()
        return True
    except Exception as e:
        print(f"[SCHEDULER INIT FAILED] {type(e).__name__}: {e}")
        return False

init_syndicate_scheduler()

if hasattr(ui, 'inject_elite_aesthetic'):
    ui.inject_elite_aesthetic()

if hasattr(ui, 'render_accountability_tickers'):
    ui.render_accountability_tickers()

st.markdown("<div style='text-align: center;'><div class='header-branding'>THE JUICER</div><div class='header-sub-tag'>QUANTITATIVE REFINERY & WAR ROOM</div></div>", unsafe_allow_html=True)
st.html(refinery_manifold.get_manifold_markup())

try:
    tabs = st.tabs([
        "🏆 Scoreboard", 
        "👑 DFS Engine", 
        "⚡ Juice Rankings", 
        "🎯 Parlay Matrix", 
        "🏈 Season-Long", 
        "⚡ PrizePicks", 
        "🎥 Film Room", 
        "⚙️ Ops Center", 
        "🤖 Learning Loop"
    ])

    with tabs[0]:
        ui_scoreboard.render_scoreboard_tab()

    with tabs[1]:
        ui_dfs.render_dfs_tab()

    with tabs[2]:
        if hasattr(ui, 'render_juice_rankings'):
            ui.render_juice_rankings()
        else:
            st.info("⚡ Juice Rankings")

    with tabs[3]:
        if hasattr(ui, 'render_real_parlay_matrix'):
            ui.render_real_parlay_matrix()
        else:
            st.info("Parlay matrix loading...")

    with tabs[4]:
        if hasattr(ui, 'render_season_long'):
            ui.render_season_long()
        else:
            st.info("Season-long rosters loading...")

    with tabs[5]:
        if hasattr(ui, 'render_prizepicks_underdog'):
            try:
                ui.render_prizepicks_underdog()
            except Exception:
                uext.render_safe_prizepicks()
        else:
            uext.render_safe_prizepicks()

    with tabs[6]:
        if hasattr(ui, 'render_film_room'):
            ui.render_film_room()
        else:
            st.info("Film room telemetry loading...")

    with tabs[7]:
        if hasattr(ui, 'render_ops_center'):
            ui.render_ops_center()
        elif hasattr(ui, 'render_telemetry'):
            ui.render_telemetry()

    with tabs[8]:
        if hasattr(ui, 'render_learning_loop'):
            ui.render_learning_loop()
        elif hasattr(ui, 'render_learning_panel'):
            ui.render_learning_panel()

except Exception as e:
    st.error(f"⚠️ War Room Render Exception: {e}")
    import traceback
    st.code(traceback.format_exc())