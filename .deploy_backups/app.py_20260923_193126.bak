    @keyframes dropB { 0% { top: -20px; opacity: 1; transform: scale(1) rotate(-5deg); } 80% { opacity: 0.8; } 100% { top: 38px; opacity: 0; transform: scale(0.3) rotate(-20deg); } }
    @keyframes dropC { 0% { top: -20px; opacity: 1; transform: scale(1) rotate(10deg); } 80% { opacity: 0.8; } 100% { top: 38px; opacity: 0; transform: scale(0.4) rotate(25deg); } }

