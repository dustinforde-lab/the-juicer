"""
The Juicer - DFS Quant Engine & Showdown Evaluator
Generates 150 Classic Main Slate Builds + 50 Showdown (TNF: ATL @ GB) Builds.
Codifies Mike's 12 Empirical Optimal Rules for Showdown.
"""
import sqlite3
import json
import random
import os

DB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "action_grid.db")

def get_db():
    conn = sqlite3.connect(DB_PATH, timeout=10.0)
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute("PRAGMA busy_timeout=10000;")
    conn.row_factory = sqlite3.Row
    return conn

def init_dfs_schema():
    with get_db() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS dfs_lineups (
                lineup_id TEXT PRIMARY KEY,
                slate_name TEXT,
                contest_type TEXT,
                format_type TEXT,
                total_salary INTEGER,
                projected_points REAL,
                floor_points REAL,
                ceiling_points REAL,
                ownership_sum REAL,
                stack_summary TEXT,
                roster_json TEXT,
                meta_json TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        # Non-destructive column addition for format_type
        try:
            conn.execute("ALTER TABLE dfs_lineups ADD COLUMN format_type TEXT DEFAULT 'CLASSIC'")
        except Exception:
            pass
        conn.commit()

