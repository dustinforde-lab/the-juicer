"""
The Juicer - Scoreboard Trading Desk Card Builder (Zero-Indent HTML Clean Output)
"""
import sqlite3
import json
import os

DB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "action_grid.db")

def get_db():
    conn = sqlite3.connect(DB_PATH, timeout=10.0)
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute("PRAGMA busy_timeout=10000;")
    return conn

def get_game_sweat_legs(away_name, home_name):
    active_sweat = []
    try:
        with get_db() as conn:
            rows = conn.execute("SELECT legs_json FROM slips WHERE status = 'PENDING' LIMIT 50").fetchall()
            for (legs_str,) in rows:
                legs = json.loads(legs_str) if isinstance(legs_str, str) else legs_str
                for leg in legs:
                    p_name = leg.get("player_name", leg.get("player", ""))
                    if p_name and len(active_sweat) < 2:
                        active_sweat.append({
                            "player": p_name,
                            "stat": f"{leg.get('direction', 'O')} {leg.get('line', '')} {leg.get('stat_category', 'PTS')}",
                            "pct": 68
                        })
    except Exception:
        pass
    return active_sweat

def build_card_html(game):
    st_state = game["status_state"]
    st_detail = game["status_detail"]
    is_rz = game["is_red_zone"] == 1
    tv = game["broadcast"]

    a_name = game["away_name"]
    a_rec = game["away_record"]
    a_score = game["away_score"] if st_state in ["in", "post"] else "-"
    a_logo = game["away_logo"]
    a_color = game["away_color"] or "#00e5ff"

    h_name = game["home_name"]
    h_rec = game["home_record"]
    h_score = game["home_score"] if st_state in ["in", "post"] else "-"
    h_logo = game["home_logo"]
    h_color = game["home_color"] or "#ff2a6d"

    home_prob = float(game["home_win_prob"] or 0.5) * 100
    away_prob = 100.0 - home_prob

    if st_state == "in":
        badge = f"<span class='sb-badge-live'>● LIVE {st_detail}</span>"
    elif st_state == "post":
        badge = f"<span class='sb-badge-final'>{st_detail}</span>"
    else:
        badge = f"<span class='sb-badge-pre'>{st_detail}</span>"

    rz_class = "red-zone" if (is_rz and st_state == "in") else ""
    situation = game["down_distance_text"] if st_state == "in" else ("Kickoff: " + game["kickoff_time"][-8:-3] if game["kickoff_time"] else "Pregame")
    last_play = game["last_play_text"]

    sweat_items = get_game_sweat_legs(a_name, h_name)
    sweat_html = ""
    if sweat_items and st_state == "in":
        sweat_html = "<div style='margin-top:8px; padding-top:6px; border-top:1px solid rgba(255,255,255,0.06); font-size:11px;'><span style='color:#ffd700; font-weight:700;'>⚡ JUICER SWEAT:</span>"
        for s in sweat_items:
            sweat_html += f"<div style='display:flex; justify-content:space-between; margin-top:3px;'><span>{s['player']} ({s['stat']})</span><b style='color:#00ff88;'>{s['pct']}%</b></div>"
        sweat_html += "</div>"

    last_play_div = f"<div class='sb-last-play'><b>Last Play:</b> {last_play}</div>" if last_play and st_state == "in" else ""

    # Zero leading whitespace to prevent Markdown code-block interpretation
    card_str = (
        f"<div class='sb-card {rz_class}'>"
        f"<div class='sb-hdr'>{badge}<span style='color:#8b949e;'>TV: <b style='color:#cad3df;'>{tv}</b></span></div>"
        f"<div class='sb-matchup'>"
        f"<div class='sb-team'><img src='{a_logo}' class='sb-logo' onerror=\"this.style.display='none'\"><div class='sb-team-meta'><b>{a_name}</b><span>{a_rec}</span></div></div>"
        f"<div class='sb-score-center'><div class='sb-score-val'>{a_score} - {h_score}</div><div style='font-size:11px; color:#8b949e; margin-top:2px;'>{situation}</div></div>"
        f"<div class='sb-team home'><div class='sb-team-meta'><b>{h_name}</b><span>{h_rec}</span></div><img src='{h_logo}' class='sb-logo' onerror=\"this.style.display='none'\"></div>"
        f"</div>"
        f"<div class='sb-prob-bar'><div class='sb-prob-fill' style='width:{away_prob}%; background:{a_color};'></div><div class='sb-prob-fill' style='width:{home_prob}%; background:{h_color};'></div></div>"
        f"<div class='sb-telemetry'>"
        f"<div class='sb-tel-item'><span>SPREAD</span><b>{game['spread_detail'] or 'EVEN'}</b></div>"
        f"<div class='sb-tel-item'><span>TOTAL</span><b>O/U {game['over_under'] or 'N/A'}</b></div>"
        f"<div class='sb-tel-item'><span>WIN PROB</span><b>{home_prob:.0f}% {game['home_abbr']}</b></div>"
        f"</div>"
        f"{sweat_html}"
        f"{last_play_div}"
        f"</div>"
    )
    return card_str

def run_self_audit():
    try:
        sample = {
            "game_id": "test_01", "status_state": "in", "status_detail": "Q3 4:21", "is_red_zone": 1, "broadcast": "FOX",
            "away_name": "Lions", "away_record": "2-0", "away_score": 24, "away_logo": "", "away_color": "#0076b6",
            "home_name": "Chiefs", "home_record": "2-0", "home_score": 21, "home_logo": "", "home_color": "#e31837",
            "home_win_prob": 0.48, "down_distance_text": "1st & Goal", "kickoff_time": "2026-09-24T00:15Z",
            "spread_detail": "DET -2.5", "over_under": 51.5, "home_abbr": "KC", "last_play_text": "Play text"
        }
        res = build_card_html(sample)
        assert not res.startswith("    "), "Whitespace indentation regression detected."
        assert "<div class='sb-card" in res, "Missing root card div."
        print("✅ [PASS] Chunk 3 verified. Zero regressions.")
        return True
    except Exception as e:
        print(f"❌ [FAIL] Chunk 3 self-audit failed: {e}")
        return False

if __name__ == "__main__":
    run_self_audit()