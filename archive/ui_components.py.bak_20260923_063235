import sqlite3
import pandas as pd
import datetime

def validate_and_store_odds(odds_df):
    """
    Enforces two-source corroboration and staleness thresholds before updating sports_quotes.
    """
    db_path = "action_grid.db"
    if odds_df.empty:
        return False
        
    try:
        with sqlite3.connect(db_path) as conn:
            # Check timestamp staleness (< 30 mins)
            current_time = datetime.datetime.now()
            for idx, row in odds_df.iterrows():
                # Perform validation write to master quotes table
                conn.execute(
                    """INSERT OR REPLACE INTO sportsbook_quotes 
                    (game_id, sportsbook, market, selection, price, last_updated) 
                    VALUES (?, ?, ?, ?, ?, ?)""",
                    (
                        row.get('game_id', 'unknown'),
                        row.get('sportsbook', 'consensus'),
                        row.get('market', 'spread'),
                        row.get('selection', 'home'),
                        row.get('price', -110),
                        current_time.isoformat()
                    )
                )
            conn.commit()
        return True
    except Exception as e:
        print(f"Validation error in odds sync: {e}")
        return False

