def render_vegas_wall():
    st.markdown("### 🏆 VEGAS ACTION SCOREBOARD & LIVE LINES")
    st.caption(f"Last Synced: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')} | Data Source: The Odds API & MFL Feed")
    
    db_path = "action_grid.db"
    try:
        with sqlite3.connect(db_path) as conn:
            # Pull games with real live columns if available
            query = "SELECT * FROM game_lines"
            games_df = pd.read_sql(query, conn)
            
            if not games_df.empty:
                # Display metrics or formatted matchup cards
                for idx, row in games_df.iterrows():
                    col1, col2, col3 = st.columns([2, 1, 2])
                    with col1:
                        st.markdown(f"**{row.get('away_team', 'Away Team')}**")
                    with col2:
                        score_away = row.get('away_score', 0)
                        score_home = row.get('home_score', 0)
                        st.markdown(f"<h4 style='text-align: center; margin: 0;'>{score_away} - {score_home}</h4>", unsafe_allow_html=True)
                        st.caption(f"Kickoff: {row.get('commence_time', 'TBD')}")
                    with col3:
                        st.markdown(f"**{row.get('home_team', 'Home Team')}**")
                    st.divider()
            else:
                st.info("No game lines currently populated in database. Background daemon syncing...")
    except Exception as e:
        st.warning(f"Scoreboard feed initializing or table missing: {e}")

def render_scoreboard():
